APP_NAME=PakaPay
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pakapay.ng

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# SQLite by default so the site runs with zero extra database setup.
# Swap to mysql/pgsql here if you'd rather point it at a managed database.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=pakapay
# DB_USERNAME=root
# DB_PASSWORD=

# File-based sessions: no extra "sessions" table/migration required.
# The base Laravel skeleton ships cache/jobs migrations but not a sessions
# one, so SESSION_DRIVER=database would break here without an extra
# `php artisan session:table` step. file avoids that for this low-traffic site.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Contact form email: set real SMTP credentials to actually receive
# submissions by email. Until then, MAIL_MAILER=log writes them to
# storage/logs/laravel.log instead of failing or silently dropping them.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@pakapay.ng"
MAIL_FROM_NAME="${APP_NAME}"
